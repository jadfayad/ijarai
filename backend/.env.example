ORS_API_KEY=your_openrouteservice_api_key_here
GOOGLE_API_KEY=your_google_maps_api_key_here

# AI Agent provider: "deepagent" (LLM-powered) or "stub" (keyword-based, no API key)
AI_AGENT_PROVIDER=stub

# DeepAgent configuration (only needed when AI_AGENT_PROVIDER=deepagent)
# Model string format: "provider:model_name"
# Examples: anthropic:claude-sonnet-4-6, openai:gpt-4o, google_genai:gemini-2.5-pro
DEEPAGENT_MODEL=anthropic:claude-sonnet-4-6

# Set the API key for your chosen model provider:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
